{
  "name": "dsh-at-skill",
  "version": "0.1.0",
  "description": "Invoke DeepSeek Harness skills with @name and show skill suggestions in the composer",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/452926826/dsh-at-skill.git"
  },
  "homepage": "https://github.com/452926826/dsh-at-skill#readme",
  "bugs": {
    "url": "https://github.com/452926826/dsh-at-skill/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skill",
    "autocomplete"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.1 <0.1.0 || >=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.0-rc.1 <0.1.0 || >=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.1 <0.1.0 || >=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.1 <0.1.0 || >=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-input-trigger": ">=0.1.0-rc.1 <0.1.0 || >=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.1 <0.1.0 || >=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.1 <0.1.0 || >=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.1 <0.1.0 || >=0.1.1-rc.1 <0.2.0-0"
  },
  "scripts": {
    "build": "tsdown",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "prepack": "npm run check"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "license": "MIT"
}
